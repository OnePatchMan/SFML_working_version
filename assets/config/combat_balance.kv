// =========================================================================
// ТАБЛИЦА БАЛАНСА БОЕВОЙ СИСТЕМЫ (KEY-VALUES / КВ ТАБЛИЦА)
// Файл: assets/config/combat_balance.kv
//
// Инструкция:
// 1. Здесь можно вручную менять урон (damage), форсу отталкивания (knock_x / knock_y),
//    стан-лок игрока при попадании (player_recovery) и промахе (whiff_stun),
//    а также стан-лок противника (enemy_stun) для всех приемов и комбо.
// 2. В игре нажмите [F5] для мгновенной горячей перезагрузки этой таблицы без перезапуска!
// =========================================================================

"CombatBalance"
{
    // =====================================================================
    // 0. ГЛОБАЛЬНЫЕ НАСТРОЙКИ БОЯ
    // =====================================================================
    "GlobalSettings"
    {
        // Глобальный множитель стана при промахе по воздуху (whiff stun)
        // Можно менять в реальном времени (например, 0.5 для быстрого темпа или 1.5 для хардкора)
        "whiff_stun_multiplier"   "1.0"

        // Скейлинг урона в длинных цепочках ударов (Damage Scaling / Proration)
        // Каждый последующий удар комбо наносит на 10% меньше урона (100% -> 90% -> 80% ... минимум 30%)
        "damage_scaling_step"     "0.10"
        "damage_scaling_min"      "0.30"

        // Система снижения времени оглушения в комбо (Hitstun Decay)
        // Уменьшение длительности стана врага с каждым ударом, исключающее бесконечные жонглирования
        "hitstun_decay_step"      "0.10"
        "hitstun_decay_min"       "0.30"

        // Зависимость объема крови от максимального здоровья врага
        // Базовое HP для нормального объема крови (45.0 - Обычный враг).
        // Чем выше maxHp врага (например, 110 у Танка), тем больше вылетает крови и тем шире ручьи!
        "finisher_blood_base_hp"  "45.0"

        // Механика отскока от стены (Wall Bounce / Wall Splat как в Mortal Kombat X)
        "wall_bounce_damage"      "4.5"      // Урон при впечатывании в стену
        "wall_bounce_force_damp"  "0.28"     // Сильно сниженная форса отскока от стены (28% от начальной скорости)
        "wall_bounce_pop_y"       "-320.0"   // Подброс вверх для продолжения углового комбо (угольный джаггл)
        "wall_bounce_min_speed"   "200.0"    // Минимальная горизонтальная скорость для активации отскока от стены
        "wall_bounce_hitstun"     "0.50"     // Время стана при отскоке от стены для комфортного продолжения серии
    }

    // =====================================================================
    // 0.1. ПАРАМЕТРЫ БРОСКА ОРУЖИЯ (MACE THROW & COMBO PHYSICS)
    // =====================================================================
    "WeaponThrow"
    {
        // Базовая скорость броска булавы (стоя на месте)
        "base_throw_speed"          "365.0"

        // Множитель добавления скорости бега/рывка игрока к скорости броска
        "speed_boost_multiplier"    "1.6"

        // Прямые броски (прямо, прямо вниз, вниз) - летят как копье без вращения
        "straight_gravity"          "980.0"

        // Броски вверх и вверх-прямо (сетап под комбо):
        "upward_spin_speed"         "1080.0"   // Скорость закручивания булавы (град/с)
        "upward_apex_hover_time"    "0.16"     // Время кратковременного зависания в пиковой точке (секунды)
        "upward_up_gravity"         "980.0"    // Гравитация при подъеме булавы вверх к пику
        "upward_fall_gravity"       "980.0"    // Гравитация при падении булавы (для комбо)
    }

