    // =================================================================
    // СТОЙКА КОНТР-АТАКИ / ПАРИРОВАНИЯ УМНОГО ИИ (COUNTER STANCE)
    // =================================================================
    "Counter"
    {
        "window"                    "0.35"      // Окно активной стойки контр-атаки бота (секунды)
        "cooldown"                  "3.50"      // Перезарядка стойки контр-атаки бота (секунды)
        "whiff_stun"                "1.20"      // ДЛИТЕЛЬНЫЙ стан-лок бота при промахе (игрок не ударил)
        "player_stun"               "1.40"      // ДЛИТЕЛЬНЫЙ стан-лок игрока, если ударил в стойку бота
        "damage"                    "7.0"       // Урон контр-удара бота по игроку
        "knock_x"                   "320.0"     // Отталкивание игрока по X
        "knock_y"                   "-40.0"     // Отталкивание игрока по Y
        "trigger_distance"          "65.0"      // Дистанция до игрока для входа в стойку
    }
}
