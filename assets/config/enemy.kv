// =====================================================================
// ТАБЛИЦА БАЛАНСА, ПАРАМЕТРОВ И КОМБО ВРАГОВ (ENEMY & COMBOS CONFIG)
// Файл конфигурации в формате KeyValues (KV)
// Поддерживает комментарии (// или #) и горячую перезагрузку по [F5]
// Позволяет настраивать как манекен, так и любые комбо-серии умного ИИ!
// =====================================================================

"EnemyConfig"
{
    // -----------------------------------------------------------------
    // 1. БАЗОВЫЕ ПАРАМЕТРЫ ПРОТИВНИКА И ПОВЕДЕНИЕ В НЕЙТРАЛЕ
    // -----------------------------------------------------------------
    "Stats"
    {
        "max_hp"                    "45.0"      // Базовое здоровье противника
        "gravity"                   "2600.0"    // Гравитация для противника (px/s^2)
        "whiff_recovery"            "0.50"      // Штрафной откат врага при промахе (whiff lag)
        "hit_recovery"              "0.20"      // Базовый откат врага при успешном ударе
        "neutral_pursuit_speed"     "220.0"     // Скорость преследования игрока в нейтрале (px/s)
        "approach_speed"            "280.0"     // Скорость рывка сближения перед стартом комбо (px/s)
        "attack_cooldown"           "0.75"      // Задержка между комбо-сериями агрессивного ИИ (сек)
    }

    // -----------------------------------------------------------------
    // АРХЕТИП 1: ОБЫЧНЫЙ ВРАГ (NORMAL ENEMY)
    // Серый цвет, малый запас ХП, легкая броня, средняя скорость,
    // дает 1 комбо, не умеет контр-атаковать.
    // -----------------------------------------------------------------
    "Normal"
    {
        "max_hp"                    "45.0"      // Малый запас здоровья
        "speed"                     "220.0"     // Средняя скорость в нейтрале
        "approach_speed"            "280.0"     // Скорость сближения
        "damage_multiplier"         "1.0"       // Базовый урон
        "scale"                     "1.0"       // Стандартный размер
        "can_counter"               "0"         // Не умеет контратаковать
        "can_block"                 "0"         // Не держит блок
        "can_dodge"                 "0"         // Не доджит
    }

    // -----------------------------------------------------------------
    // АРХЕТИП 2: ЖИРНЫЙ ВРАГ (TANK / BRUTE)
    // Красный цвет, в 1.5 раза больше, большой запас ХП, тяжелая броня,
    // меньше времени в стане, слабее отталкивается, бьет дальше и больнее.
    // -----------------------------------------------------------------
    "Tank"
    {
        "max_hp"                    "110.0"     // Большой запас здоровья
        "speed"                     "135.0"     // Медленная скорость в нейтрале
        "approach_speed"            "180.0"     // Скорость сближения
        "damage_multiplier"         "1.65"      // Повышенный урон
        "hitbox_scale"              "1.50"      // Бьет на большую дистанцию (увеличенный хитбокс)
        "scale"                     "1.50"      // Больше в 1.5 раза
        "stun_multiplier"           "0.55"      // В стане находится на 45% меньше времени
        "knock_multiplier"          "0.50"      // Отталкивается в 2 раза слабее
        "windup_multiplier"         "1.30"      // Бьет слегка медленнее
        "can_counter"               "0"         // Не умеет контратаковать
        "can_block"                 "1"         // Умеет закрываться блоком
    }

    // -----------------------------------------------------------------
    // АРХЕТИП 3: АГРЕССИВНЫЙ ДУЭЛЯНТ (DUELIST AGGRESSIVE)
    // Фиолетовый цвет, среднее ХП, легкая броня, высокая скорость,
    // длинный зацеп с притягиванием (Grapple Pull) в лаунчер или толчок,
    // неумолимый прессинг без передышки, доджи и паниш станов игрока.
    // -----------------------------------------------------------------
    "Duelist"
    {
        "max_hp"                    "65.0"      // Средний запас здоровья
        "speed"                     "340.0"     // Высокая скорость в нейтрале
        "approach_speed"            "420.0"     // Быстрый рывок сближения
        "damage_multiplier"         "1.15"      // Слегка повышенный урон
        "scale"                     "1.0"       // Стандартный атлетичный размер
        "can_counter"               "1"         // Умеет контратаковать
        "can_block"                 "1"         // Умеет ставить блок
        "can_dodge"                 "1"         // Умеет доджить (в стороны и на месте)
        "aggressiveness"            "0.95"      // Бешеный напор без передышки
        "intelligence"              "0.85"      // Интеллект: сложность комбо и реакция на стан
        "dodge_cooldown"            "1.50"      // Перезарядка доджа (1.5 сек)
        "spacing_distance"          "108.0"     // Ближняя дистанция (~108px), вне досягаемости ударов игрока (~104px с выпадом), не в упор!
        "idle_attack_delay"         "0.50"      // Время ожидания перед атакой, если игрок бездействует
    }

    // -----------------------------------------------------------------
    // АРХЕТИП 4: ПАССИВНЫЙ ДУЭЛЯНТ (DUELIST PASSIVE)
    // Голубой цвет, среднее ХП, дисциплинированный нейтрал,
    // тактическая невидимость на 1 сек раз в 7 сек, идеальный блок и парирование,
    // почти не ошибается (интеллект 0.95) и мгновенно панишит станы игрока.
    // -----------------------------------------------------------------
    "DuelistPassive"
    {
        "max_hp"                    "65.0"      // Средний запас здоровья
        "speed"                     "320.0"     // Скорость маневрирования
        "approach_speed"            "380.0"     // Рывок сближения при панише
        "damage_multiplier"         "1.15"      // Слегка повышенный урон
        "scale"                     "1.0"       // Стандартный атлетичный размер
        "can_counter"               "1"         // Умеет контратаковать / парировать
        "can_block"                 "1"         // Умеет ставить блок
        "can_dodge"                 "1"         // Умеет доджить
        "aggressiveness"            "0.25"      // Пассивный выжидающий стиль
        "intelligence"              "0.95"      // Практически не ошибается (95% шанс паниша стана)
        "dodge_cooldown"            "2.00"      // Перезарядка доджа (2.0 сек)
        "spacing_distance"          "115.0"     // Дистанция выжидания и маневрирования (115px)
        "invis_duration"            "1.00"      // Длительность невидимости (сек)
        "invis_cooldown"            "7.00"      // Перезарядка невидимости (сек)
    }

    // -----------------------------------------------------------------
    // 2. АТАКА ТРЕНИРОВОЧНОГО МАНЕКЕНА (DUMMY ATTACK)
    // -----------------------------------------------------------------
    "DummyAttack"
    {
        "windup"                    "0.38"      // Время замаха / телеграфа удара (сек)
        "windup_frames"             "23"        // Кадры замаха (при 60 FPS)
        "active_frames"             "10"        // Кадры активного хитбокса
        "duration_frames"           "45"        // Общая длительность атаки в кадрах
        "active_time"               "0.16"      // Длительность активной фазы хитбокса
        "recovery"                  "0.20"      // Время восстановления после удара
        "damage"                    "1.5"       // Урон манекена (снижен для комфортного баланса)
        "knock_x"                   "250.0"     // Горизонтальный толчок игрока
        "knock_y"                   "-30.0"     // Вертикальный импульс
        "stun"                      "0.25"      // Длительность стана игрока при попадании
        "cooldown"                  "2.40"      // Время перезарядки между атаками манекена
        "hitbox_w"                  "55.0"      // Ширина хитбокса удара
        "hitbox_h"                  "42.0"      // Высота хитбокса удара
        "hitbox_offset_y"           "-18.0"     // Смещение хитбокса по высоте
    }

    // -----------------------------------------------------------------
    // 3. КОМБО-СВЯЗКИ УМНОГО ИИ (SMART AI COMBOS)
    // Здесь настраиваются все удары, тайминги, форса, смещения и хитбоксы
    // -----------------------------------------------------------------
    "Combos"
    {
        // -------------------------------------------------------------
