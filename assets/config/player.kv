// =====================================================================
// ТАБЛИЦА БАЛАНСА И ПАРАМЕТРОВ ИГРОКА (PLAYER CONFIG)
// Файл конфигурации в формате KeyValues (KV)
// Поддерживает комментарии (// или #) и горячую перезагрузку по [F5]
// =====================================================================

"PlayerConfig"
{
    // Базовые параметры здоровья и движения
    "Stats"
    {
        "max_hp"                    "100.0"     // Максимальное здоровье игрока
        "move_speed"                "400.0"     // Скорость бега по горизонтали (px/s)
        "gravity"                   "3000.0"    // Базовая гравитация падения (px/s^2)
        "jump_speed"                "900.0"     // Начальная вертикальная скорость прыжка (px/s)
        "max_fall_speed"            "1800.0"    // Предельная терминальная скорость падения
    }

    // Параметры направленного рывка (Dash)
    "Dash"
    {
        "dash_speed"                "1250.0"    // Скорость перемещения во время рывка (px/s)
        "dash_duration"             "0.09"      // Длительность активной фазы рывка (секунды)
        "dash_cooldown"             "0.30"      // Задержка перед следующим рывком (секунды)
        "iframe_duration"           "0.13"      // Окно неуязвимости (i-frames) при рывке
    }

    // Параметры уворота на месте и идеального уворота (Spot Dodge / Perfect Dodge)
    "SpotDodge"
    {
        "spot_dodge_duration"       "0.22"      // Длительность неуязвимости при увороте на месте
        "spot_dodge_cooldown"       "0.32"      // Перезарядка уворота на месте
        "perfect_dodge_window"      "0.11"      // Окно идеального уворота в первые доли секунды
        "perfect_dodge_empower"     "1.40"      // Время усиления для нанесения контратаки
    }

    // Размеры коллизии тела персонажа
    "Collision"
    {
        "half_w"                    "20.0"      // Половина ширины хитбокса (общая ширина = 40px)
        "top_offset"                "25.0"      // Смещение хитбокса вверх от центра
        "bottom_offset"             "30.0"      // Смещение хитбокса вниз от центра
    }

    // Стойка контр-атаки / парирования на кнопку [Q]
    "Counter"
    {
        "window"                    "0.30"      // Активное окно стойки контр-атаки (секунды)
        "cooldown"                  "1.20"      // Перезарядка стойки контр-атаки (секунды)
        "whiff_stun"                "1.00"      // ДЛИТЕЛЬНЫЙ стан-лок игрока при промахе (враг не ударил)
        "enemy_stun"                "1.50"      // ДЛИТЕЛЬНЫЙ стан врага при успешном парировании
        "damage"                    "6.0"       // Урон контр-удара игрока при парировании
        "knock_x"                   "350.0"     // Отталкивание врага по X
        "knock_y"                   "-50.0"     // Отталкивание врага по Y
    }
}

